# ─────────────────────────────────────────────────────────────
# AgenticInventory AI — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy to backend/.env and fill in required values.

# ─── Database (required) ─────────────────────────────────
# Local dev (zero-setup): SQLite — file auto-created in backend/
DATABASE_URL=sqlite+aiosqlite:///./agenticinventory.db
# Azure / production: use Postgres instead, e.g.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/agenticinventory

# ─── Redis (optional locally; Azure Cache uses rediss:// — set by Bicep in App Service) ──
REDIS_URL=redis://localhost:6379/0

# ─── Frontend URL (email deep links; set to Azure Static Web App URL in production) ──
FRONTEND_BASE_URL=http://localhost:5173

# ─── JWT Authentication (required — change in production!) ──
JWT_SECRET_KEY=change-me-in-production-use-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS (add Azure Static Web App URL in production) ─────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Groq LLM (required for AI agents) ──────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_LIGHTWEIGHT_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=4096

# ─── Intelligence APIs (optional — enables enhanced forecasting) ──
NEWS_API_KEY=
OPENWEATHER_API_KEY=
CALENDARIFIC_API_KEY=
INTELLIGENCE_DEFAULT_LOCATION=New York,US

# ─── SMTP Email (optional — simulation mode if empty) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AgenticInventory AI
ADMIN_NOTIFICATION_EMAIL=

# ─── Application ─────────────────────────────────────────
APP_NAME=AgenticInventory AI
DEBUG=false
